{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "allow": [],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git clone *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(pytest *)",
      "Bash(python backend/run_tests.py*)",
      "Bash(npm install*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(alembic *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(run_in_background:true)",
      "WebFetch",
      "WebSearch",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git pull *)",
      "PowerShell(git fetch *)",
      "PowerShell(git clone *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git checkout *)",
      "PowerShell(docker *)",
      "PowerShell(pytest *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Start-BitsTransfer *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker-compose down -v*)",
      "Bash(docker-compose down --volumes*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Remove-Item * -Recurse -Force*)",
      "PowerShell(Remove-Item * -Force*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(docker compose down --volumes*)",
      "PowerShell(docker-compose down -v*)",
      "PowerShell(docker-compose down --volumes*)"
    ]
  }
}
