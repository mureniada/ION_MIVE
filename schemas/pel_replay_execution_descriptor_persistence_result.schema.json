{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ion.local/schemas/pel_replay_execution_descriptor_persistence_result.schema.json",
  "title": "ION PEL ReplayExecutionDescriptorPersistenceResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_id",
    "descriptor_bytes_sha256",
    "readback_verified",
    "status"
  ],
  "properties": {
    "descriptor_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "descriptor_bytes_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "readback_verified": { "type": "boolean" },
    "status": { "enum": ["EXECUTION_DESCRIPTOR_PERSISTED_VERIFIED"] }
  }
}
