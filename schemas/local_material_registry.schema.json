{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalMaterialRegistry",
  "description": "Registry of local ION working materials. Local-only: this contract describes material stored under local_materials/ and never describes the protected Qdrant Cloud corpus.",
  "type": "object",
  "required": [
    "registry_version",
    "materials"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source_file",
          "version",
          "status",
          "authority",
          "retrieval_enabled",
          "approved_for_publication"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "approved"
            ]
          },
          "authority": {
            "type": "string",
            "enum": [
              "working_material",
              "reference",
              "canonical"
            ]
          },
          "retrieval_enabled": {
            "type": "boolean"
          },
          "approved_for_publication": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
