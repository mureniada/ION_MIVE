{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ion.local/schemas/pel_normalized_judgment_artifact.schema.json",
  "title": "ION PEL NormalizedJudgmentArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "normalized_artifact_id",
    "run_id",
    "evidence_id",
    "source_raw_sha256",
    "output_contract_id",
    "parser_id",
    "parser_version",
    "normalized_schema_id",
    "relative_path",
    "normalized_content_sha256",
    "artifact_bytes_sha256",
    "persisted_at",
    "status"
  ],
  "properties": {
    "normalized_artifact_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "source_raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output_contract_id": { "type": "string", "minLength": 1 },
    "parser_id": { "type": "string", "minLength": 1 },
    "parser_version": { "type": "string", "minLength": 1 },
    "normalized_schema_id": { "type": "string", "minLength": 1 },
    "relative_path": { "type": "string", "minLength": 1 },
    "normalized_content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_bytes_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "persisted_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["NORMALIZED_FROZEN"] }
  }
}
